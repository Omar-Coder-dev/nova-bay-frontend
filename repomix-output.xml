                key={cat.value}
                href={`/products?category=${cat.value}`}
                className="flex flex-col items-center gap-2 rounded-2xl border border-border bg-card p-4 text-center transition-all hover:border-blue-500/50 hover:shadow-md"
              >
                <span className="text-3xl">{cat.emoji}</span>
                <span className="text-xs font-semibold text-foreground">
                  {cat.label}
                </span>
              </Link>
            ))}
          </div>
        </div>
      </section>

      <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
        {/* ---------------- New Arrivals ---------------- */}
        <section className="py-10">
          <div className="mb-5 flex items-end justify-between">
            <h2 className="text-2xl font-bold text-foreground">New Arrivals</h2>
            <Link
              href="/products"
              className="flex items-center gap-1 text-sm font-semibold text-blue-500 hover:text-blue-400"
            >
              View all
              <ArrowRight className="h-4 w-4" />
            </Link>
          </div>

          {loading ? (
            <div className="flex gap-3 overflow-hidden">
              {Array.from({ length: 6 }).map((_, i) => (
                <div
                  key={i}
                  className="h-64 w-[15.5%] shrink-0 animate-pulse rounded-2xl bg-card"
                />
              ))}
            </div>
          ) : (
            <ProductCarousel products={newArrivals} />
          )}
        </section>

        {/* ---------------- Promo band (full-bleed color to break up whitespace) ---------------- */}
        {!loading && (
          <section className="-mx-4 my-2 rounded-3xl bg-gradient-to-r from-blue-600/10 via-indigo-600/10 to-purple-600/10 px-4 py-10 sm:mx-0 sm:px-8">
            <div className="flex flex-col items-center justify-between gap-6 sm:flex-row">
              <div className="flex items-center gap-4">
                <div className="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white">
