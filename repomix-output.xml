                  </p>
                </div>
              </div>
              <Link href="/products">
                <Button className="h-11 bg-blue-600 px-6 font-semibold text-white hover:bg-blue-500">
                  Start Shopping
                </Button>
              </Link>
            </div>
          </section>
        )}

        {/* ---------------- Top Rated ---------------- */}
        {!loading && topRated.length > 0 && (
          <section className="py-10">
            <div className="mb-5 flex items-end justify-between">
              <h2 className="text-2xl font-bold text-foreground">Top Rated</h2>
              <Link
                href="/products?sortBy=rating"
                className="flex items-center gap-1 text-sm font-semibold text-blue-500 hover:text-blue-400"
              >
                View all
                <ArrowRight className="h-4 w-4" />
              </Link>
            </div>
            <ProductCarousel products={topRated} />
          </section>
        )}

        {/* ---------------- Budget Picks ---------------- */}
        {!loading && budgetPicks.length > 0 && (
          <section className="py-10">
            <div className="mb-5 flex items-end justify-between">
              <h2 className="flex items-center gap-2 text-2xl font-bold text-foreground">
                <Tag className="h-6 w-6 text-green-500" />
                Budget Picks Under $50
              </h2>
              <Link
                href="/products?sortBy=price_asc"
                className="flex items-center gap-1 text-sm font-semibold text-blue-500 hover:text-blue-400"
              >
                View all
                <ArrowRight className="h-4 w-4" />
              </Link>
            </div>
            <ProductCarousel products={budgetPicks} />
          </section>
        )}
      </div>

      {/* ---------------- Trust badges (full-bleed band) ---------------- */}
      <section className="border-t border-border bg-card/50">
        <div className="mx-auto grid max-w-[1600px] grid-cols-1 gap-6 px-4 py-12 sm:grid-cols-3 sm:px-6 lg:px-8">
          <div className="flex items-center gap-4">
            <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/10">
              <Truck className="h-6 w-6 text-blue-500" />
            </div>
            <div>
              <p className="font-semibold text-foreground">Fast Shipping</p>
              <p className="text-sm text-muted-foreground">
                Estimated delivery on every order
              </p>
            </div>
          </div>

          <div className="flex items-center gap-4">
            <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/10">
              <ShieldCheck className="h-6 w-6 text-blue-500" />
            </div>
            <div>
              <p className="font-semibold text-foreground">Secure Checkout</p>
              <p className="text-sm text-muted-foreground">
                Payments handled securely by Stripe
              </p>
            </div>
          </div>

          <div className="flex items-center gap-4">
            <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/10">
              <RotateCcw className="h-6 w-6 text-blue-500" />
            </div>
            <div>
              <p className="font-semibold text-foreground">Easy Cancellation</p>
              <p className="text-sm text-muted-foreground">
                Cancel eligible orders anytime
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  );
}
